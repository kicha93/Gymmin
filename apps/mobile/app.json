{
  "expo": {
    "name": "Gymmin",
    "slug": "gymmin",
    "version": "1.0",
    "icon": "./assets/gymmin-app-icon.png",
    "orientation": "default",
    "userInterfaceStyle": "light",
    "ios": {
      "buildNumber": "1",
      "supportsTablet": true,
      "bundleIdentifier": "com.gymmin.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/gymmin-app-icon.png"
      },
      "versionCode": 2,
      "package": "com.gymmin.app"
    },
    "plugins": [
      "expo-secure-store",
      "expo-video"
    ]
  }
}
