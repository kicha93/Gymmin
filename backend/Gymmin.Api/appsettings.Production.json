{
  "Gymmin": {
    "Storage": {
      "Provider": "Database",
      "DatabaseProvider": "PostgreSQL",
      "ApplyMigrationsOnStartup": false,
      "ImportAppDataOnStartup": false,
      "RequireCurrentSchema": true,
      "ReadinessCacheSeconds": 15
    },
    "Diagnostics": {
      "Enabled": false
    },
    "Logging": {
      "JsonConsole": true
    },
    "DataRetention": {
      "Enabled": true,
      "IntervalHours": 6,
      "ExpiredResetTokenDays": 7,
      "ExpiredSessionDays": 30,
      "RtdnEventDays": 90
    },
    "Features": {
      "AiEnabled": true
    },
    "WorkoutCreator": {
      "Worker": {
        "PollMilliseconds": 500,
        "LeaseSeconds": 300
      }
    },
    "AiCredits": {
      "DevGrantEnabled": false
    },
    "Cors": {
      "AllowedOrigins": []
    },
    "Security": {
      "HttpsRedirectionEnabled": true,
      "EnforcePostgreSqlProduction": true,
      "ExternalHttpTimeoutSeconds": 120,
      "SmtpTimeoutSeconds": 30,
      "RequestLimits": {
        "DefaultBytes": 4194304,
        "AvatarBytes": 2162688,
        "BugReportBytes": 65536,
        "IntegrationBytes": 65536,
        "AiBytes": 524288
      }
    }
  }
}
