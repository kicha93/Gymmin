{
  "Gymmin": {
    "Storage": {
      "Provider": "File",
      "DatabaseProvider": "SQLite",
      "ApplyMigrationsOnStartup": false,
      "ImportAppDataOnStartup": false,
      "RequireCurrentSchema": true,
      "ReadinessCacheSeconds": 15
    },
    "Diagnostics": {
      "Enabled": false
    },
    "Features": {
      "AiEnabled": true
    },
    "WorkoutCreator": {
      "Worker": {
        "PollMilliseconds": 500,
        "LeaseSeconds": 300
      }
    },
    "Proxy": {
      "ForwardedHeadersEnabled": false,
      "ForwardLimit": 1,
      "KnownProxies": []
    },
    "Cors": {
      "AllowedOrigins": []
    },
    "Security": {
      "HttpsRedirectionEnabled": false,
      "EnforcePostgreSqlProduction": true,
      "ExternalHttpTimeoutSeconds": 120,
      "SmtpTimeoutSeconds": 30,
      "RequestLimits": {
        "DefaultBytes": 4194304,
        "AvatarBytes": 2162688,
        "BugReportBytes": 65536,
        "AiBytes": 524288
      }
    },
    "Auth": {
      "EmailVerificationCodeMinutes": 30,
      "RateLimits": {
        "Enabled": true,
        "RegisterIp": { "Limit": 10, "WindowMinutes": 60 },
        "RegisterEmail": { "Limit": 3, "WindowMinutes": 60 },
        "AccountDeletionUser": { "Limit": 5, "WindowMinutes": 15 },
        "AccountDeletionIp": { "Limit": 20, "WindowMinutes": 60 },
        "AvatarUploadUser": { "Limit": 10, "WindowMinutes": 60 },
        "DataSyncUser": { "Limit": 120, "WindowMinutes": 15 },
        "WorkoutCreatorUser": { "Limit": 10, "WindowMinutes": 60 },
        "WorkoutCreatorIp": { "Limit": 30, "WindowMinutes": 60 }
      }
    },
    "AiCredits": {
      "InitialGrant": 1,
      "PlanCost": 1,
      "RewriteCost": 1,
      "DevGrantEnabled": true,
      "Packs": [
        {
          "ProductId": "ai_tokens_1",
          "Credits": 1,
          "DisplayName": "1 kredyt",
          "Active": true
        },
        {
          "ProductId": "ai_tokens_3",
          "Credits": 3,
          "DisplayName": "3 kredyty",
          "Active": true
        },
        {
          "ProductId": "ai_tokens_10",
          "Credits": 10,
          "DisplayName": "10 kredytow",
          "Active": true
        }
      ]
    },
    "GooglePlay": {
      "Enabled": false,
      "PackageName": "com.gymmin.app",
      "ServiceAccountJsonPath": "",
      "ServiceAccountJsonBase64": "",
      "ValidatePurchases": true,
      "ConsumePurchases": true,
      "RtdnEnabled": false,
      "RtdnAudience": "",
      "RtdnServiceAccountEmail": "",
      "VoidedPurchasesEnabled": false,
      "VoidedPurchasesPollMinutes": 60,
      "VoidedPurchasesInitialLookbackDays": 30,
      "VoidedPurchasesOverlapMinutes": 120,
      "AutoClawbackUnusedCredits": true
    },
    "Admin": {
      "Enabled": false,
      "KeyId": "",
      "ApiKeySha256": ""
    },
    "DataRetention": {
      "Enabled": false,
      "IntervalHours": 6,
      "ExpiredResetTokenDays": 7,
      "ExpiredSessionDays": 30,
      "RtdnEventDays": 90
    }
  },
  "SystemStatus": {
    "Kind": "ok",
    "MessagePl": "",
    "MessageEn": ""
  },
  "BugReports": {
    "EmailDelivery": {
      "PollSeconds": 10,
      "BatchSize": 20
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=App_Data/gymmin-dev.db"
  }
}
