{
  "name": "gymmin",
  "private": true,
  "scripts": {
    "docs:validate": "node scripts/validate-documentation.mjs",
    "security:secrets": "node scripts/validate-tracked-secrets.mjs",
    "security:dependencies": "npm --prefix apps/mobile run security:dependencies",
    "google-play:validate": "node scripts/validate-google-play-release.mjs",
    "mobile:test": "npm --prefix apps/mobile run test",
    "mobile:typecheck": "npm --prefix apps/mobile run typecheck",
    "mobile:guard:local-only": "node scripts/validate-local-only-runtime.mjs",
    "mobile:guard:local-product": "node scripts/validate-local-product-runtime.mjs",
    "mobile:catalog:check": "node scripts/validate-exercise-catalog.mjs",
    "mobile:security:android": "npm --prefix apps/mobile run security:android",
    "mobile:security:android-components": "npm --prefix apps/mobile run security:android-components",
    "mobile:build:android-apk": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-android-apk.ps1",
    "mobile:github:apk:oneclick": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-github-apk-oneclick.ps1",
    "mobile:apk:publish-github": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/publish-apk-github.ps1",
    "mobile:store:aab": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-store-android-aab.ps1",
    "mobile:ios:personal": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-ios-unsigned-oneclick.ps1",
    "mobile:ios:unsigned:oneclick": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-ios-unsigned-oneclick.ps1",
    "exercise:images:dry-run": "node scripts/generate-exercise-images-openai.mjs --dry-run",
    "exercise:images:generate": "node scripts/generate-exercise-images-openai.mjs",
    "exercise:media:optimize": "node scripts/optimize-exercise-media.mjs --write",
    "exercise:media:sync": "node scripts/sync-exercise-image-assets.mjs",
    "exercise:media:validate": "node scripts/validate-exercise-media.mjs",
    "exercise:catalog:audit": "node scripts/audit-exercise-catalog.mjs",
    "exercise:catalog:validate": "node scripts/validate-exercise-catalog.mjs",
    "exercise:catalog:export": "node scripts/export-exercise-summary.mjs",
    "exercise:catalog:export:enrichment": "node scripts/export-exercise-enrichment-catalog.mjs",
    "exercise:catalog:apply": "node scripts/apply-exercise-catalog-update.mjs",
    "exercise:catalog:report": "node scripts/generate-exercise-refactor-report.mjs",
    "exercise:catalog:audit:phase2": "node scripts/audit-exercise-catalog-phase2.mjs",
    "exercise:muscles:generate": "node scripts/generate-advanced-muscle-profiles.mjs",
    "exercise:muscles:validate": "node scripts/validate-advanced-muscles.mjs",
    "exercise:muscles:audit": "node scripts/audit-advanced-muscle-profiles.mjs"
  }
}
